# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# env - keep .env.example current, never commit real env files
.env
.env.*
!.env.example

# test artifacts
coverage/
playwright-report/
test-results/

# tooling caches
.vite/
.eslintcache
.pnpm-store/

# logs & OS noise
*.log
.DS_Store

# regenerable ingest output (run `pnpm ingest` locally when curating)
curation-report.txt

# per-user agent state (project settings/skills ARE committed)
.claude/settings.local.json
.claude/scheduled_tasks.lock
